{{ 'faq-bundle.css' | asset_url | stylesheet_tag }}
<script src="{{ 'faq-bundle.js' | asset_url }}"  defer="defer"></script>

<section class="faq-section">
  <div class="faq-container">
    <h2 class="faq-title">Frequently Asked Questions</h2>
    
    <div class="faq-item">
      <button class="faq-question">
        1. How do I select the honey Variants?
        <span class="faq-icon">+</span>
      </button>
      <div class="faq-answer">
        <p>Choose any 5 Variants (Wild, Neem, Jamun, Van Tulsi, Mustard, Acacia) from the product page. Only 2 Wild Honey jars are allowed due to limited stock.</p>
      </div>
    </div>

    <div class="faq-item">
      <button class="faq-question">
        2. What items are included in the “7 Free Gifts” offer with this purchase?
        <span class="faq-icon">+</span>
      </button>
      <div class="faq-answer">
        <p>You will receive 5 free spread sachets (10 g each) with your order. This freebie pack also includes Organic Cow Milk (200 ml) and a free stick as part of the promotional offer.</p>
      </div>
    </div>

     <div class="faq-item">
      <button class="faq-question">
        3. Is this a limited-time offer?
        <span class="faq-icon">+</span>
      </button>
      <div class="faq-answer">
        <p>Yes, this is a limited-time monthly offer, starting from 1st Nov 2025  and ending on 30th Nov 2025.</p>
      </div>
    </div>

    <div class="faq-item">
      <button class="faq-question">
        4. Is COD available?
        <span class="faq-icon">+</span>
      </button>
      <div class="faq-answer">
        <p>Yes, Free Shipping & COD are available all over India.</p>
      </div>
    </div>

    <div class="faq-item">
      <button class="faq-question">
        5. Do prepaid orders get extra discount?
        <span class="faq-icon">+</span>
      </button>
      <div class="faq-answer">
        <p>Yes, prepaid orders receive an additional 2% discount automatically at checkout.</p>
      </div>
    </div>

    <div class="faq-item">
      <button class="faq-question">
        6. Why is no coupon applied?
        <span class="faq-icon">+</span>
      </button>
      <div class="faq-answer">
        <p>The ₹1499 price for any 5 honey jars applies automatically. The MRP of the combo is ₹1845.</p>
      </div>
    </div>

  </div>
</section>


