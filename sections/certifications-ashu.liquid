<section class="certifications-section" style="background-color: {{ section.settings.color_scheme }};">
  <div class="page-width">
    <!-- Title -->
    <h2>{{ section.settings.title }}</h2>
    
    <!-- Slider Wrapper -->
    <div class="certifications-section__slider">
      <div class="certifications-section__wrapper">
          <div class="certifications-section__item">
            <img src="{{ section.settings.image_1 | image_url }}" alt="Certification" />
          </div>
          <div class="certifications-section__item">
            <img src="{{ section.settings.image_2 | image_url }}" alt="Certification" />
          </div>
          <div class="certifications-section__item">
            <img src="{{ section.settings.image_3 | image_url }}" alt="Certification" />
          </div>
          <div class="certifications-section__item">
            <img src="{{ section.settings.image_4 | image_url }}" alt="Certification" />
          </div>
          <div class="certifications-section__item">
            <img src="{{ section.settings.image_5 | image_url }}" alt="Certification" />
          </div>
          <div class="certifications-section__item">
            <img src="{{ section.settings.image_6 | image_url }}" alt="Certification" />
          </div>
          <div class="certifications-section__item">
            <img src="{{ section.settings.image_7 | image_url }}" alt="Certification" />
          </div>
          <div class="certifications-section__item">
            <img src="{{ section.settings.image_8 | image_url }}" alt="Certification" />
          </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Certifications Section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Certifications"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Background Color Scheme",
      "default": "background-1"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Certification Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Certification Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Certification Image 3"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Certification Image 4"
    },
    {
      "type": "image_picker",
      "id": "image_5",
      "label": "Certification Image 5"
    },
    {
      "type": "image_picker",
      "id": "image_6",
      "label": "Certification Image 6"
    },
    {
      "type": "image_picker",
      "id": "image_7",
      "label": "Certification Image 7"
    },
    {
      "type": "image_picker",
      "id": "image_8",
      "label": "Certification Image 8"
    }
  ],
  "presets": [
    {
      "name": "Certifications Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<style>
.certifications-section {
  padding: 10px 0 50px 0;
  text-align: center;
}

.certifications-section__title {
  font-size: 2rem;
  font-weight: bold;
  margin-bottom: 30px;
  color: var(--color-foreground);
}

.certifications-section__slider {
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
}

.certifications-section__wrapper {
  display: flex;
  gap: 10px;
  scroll-snap-align: start;
  padding: 10px;
}

.certifications-section__item {
  flex: 0 0 auto; /* Prevent items from shrinking */
  width: 100px;
}

.certifications-section__item img {
  width: 100%;
  height: auto;
  display: block;
}
</style>

