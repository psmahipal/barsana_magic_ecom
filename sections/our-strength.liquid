<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

<div class="our-strength page-width">
  <div class="section-header text-center mb-8">
    <h2 class="text-2xl">{{ section.settings.heading }}</h2>
    <p class="text-sm text-gray-600 mt-2">{{ section.settings.description }}</p>
  </div>

  <!-- Grid layout container for our items -->
  <div class="items-container">
    <!-- Source -->
    <div class="item strength-section">
      <div class="flex items-start space-x-4">

        <!-- <img
          src="https://cdn.shopify.com/s/files/1/0731/2634/7008/files/homepage_icons-04.png?v=1738642820"
          alt="Sustainable Sourcing"
          class="w-12 h-12"
          data-aos="fade-right"
          data-aos-duration="1000"
          width="1"
          height="1"
        > -->

        <img
          data-twic-src="image:cat_1x1.jpg"
          src="https://cdn.shopify.com/s/files/1/0731/2634/7008/files/homepage_icons-04.png?v=1738642820"
          width="1"
          height="1"
        />
        <div>
          <h3 data-aos="fade-up" data-aos-duration="1000">Sustainable Sourcing</h3>
          <p class="text-sm" data-aos="fade-up" data-aos-duration="1000">
            We partner with farmers across India to ensure pure, natural ingredients. Our sourcing focuses on
            sustainability, supporting the farmers, and providing them with organic certifications and training.
          </p>
        </div>
      </div>
    </div>

    <div class="stateofart">
      <!-- Flex container for heading and image (on the same line) -->
      <div class="flex items-center space-x-4">
        <h3 data-aos="fade-up" data-aos-duration="1000">State-of-the-Art Facilities</h3>
        <img
          src="https://cdn.shopify.com/s/files/1/0731/2634/7008/files/homepage_icons-02.png?v=1734247248"
          alt="Ethics Icon"
          class="icon-image"
          data-aos="fade-left"
          data-aos-duration="1000"
          width="1"
          height="1"
        >
      </div>

      <!-- Text content below the heading and image -->
      <p class="text-sm" data-aos="fade-up" data-aos-duration="1000">
        Our facilities use advanced technology to process organic products with the utmost quality. We maintain purity,
        preserve nutrients, and ensure that products remain fresh and unadulterated.
      </p>
    </div>

    <div class="stateofart">
      <!-- Flex container for heading and image (on the same line) -->
      <div class="flex items-center space-x-4">
        <h3 data-aos="fade-up" data-aos-duration="1000">Teamwork: Working Together for a Better Future</h3>
        <img
          src="https://cdn.shopify.com/s/files/1/0731/2634/7008/files/homepage_icons-03.png?v=1734247248"
          alt="Ethics Icon"
          class="icon-image"
          data-aos="fade-right"
          data-aos-duration="1000"
          width="1"
          height="1"
        >
      </div>

      <!-- Text content below the heading and image -->
      <p class="text-sm" data-aos="fade-up" data-aos-duration="1000">
        Teamwork is our main strength. Our farmers, experts, and support teams collaborate to improve farming practices
        while also looking after their welfare and producing organic food safe for consumers.
      </p>
    </div>

    <div class="item strength-section" style="margin-top: 20%;">
      <div class="flex items-start space-x-4">
        <div>
          <h3 data-aos="fade-up" data-aos-duration="1000">Quality Check: Ensuring Purity at Every Step</h3>
          <p class="text-sm" data-aos="fade-up" data-aos-duration="1000">
            We rigorously test products at every stage to ensure quality and purity. Third-party lab checks and
            eco-friendly packaging guarantee that our products are safe, organic, and environmentally responsible.
          </p>
        </div>
        <img
          src="https://cdn.shopify.com/s/files/1/0731/2634/7008/files/homepage_icons-04.png?v=1734247248"
          alt="Efficacy Icon"
          class="w-12 h-12"
          data-aos="fade-right"
          data-aos-duration="1000"
          width="1"
          height="1"
        >
      </div>
    </div>
  </div>
</div>

<style>
      /* Global styles for the section */
      .our-strength {
        background-size: cover;
        position: relative;
        padding: 2rem;
      }

      /* Apply background image only for desktop screens */
      @media (min-width: 768px) {
        .our-strength {
          background-image: url('https://cdn.shopify.com/s/files/1/0731/2634/7008/files/vintage-bg.png?v=1734341203');
        }
      }

      /* Hide background image for smaller screens (mobile) */
      @media (max-width: 767px) {
        .our-strength {
          background-image: none;
        }
      }


      .section-header h2 {
        text-align: center;
        color: #333;
        margin-bottom: 0.5rem;
      }

      .section-header p {
        text-align: center;
      }

      /* Container for all items */
      .items-container {
        display: grid;
        grid-template-columns: 1fr 1fr; /* Two columns layout by default */
        gap: 1.5rem; /* Spacing between items */
      }

      /* Flex item (Icon + Text) */
      .item {
        display: flex;
        align-items: flex-start;
      }

      .item img {
        object-fit: contain;
        width: 20rem; /* Icon width */
        height: 20rem; /* Icon height */
      }

      .item h3 {
        margin-bottom: 0.5rem;
      }

      /* Ensure this styling only applies to the 'strength-section' */
    .strength-section {
      padding: 16px; /* Optional: Add padding around the section */
    }

    /* Flexbox container for the image and text */
    .strength-section .flex {
      display: flex;           /* Arrange image and text in a horizontal row */
      align-items: flex-start; /* Align items at the top */
      gap: 16px;               /* Space between image and text */
    }


    /* styles are applied only to the 'stateofart' section */
    .stateofart {
      padding: 16px; /* Optional: Add padding around the section */
    }

    /* Flex container for heading and image (on the same line) */
    .stateofart .flex {
      display: flex;
      align-items: end;  /* Align items vertically centered */
      gap: 16px;            /* Space between heading and image */
    }

    /* Styling for the heading (title) */
    .stateofart .text-xl {
      font-size: 2.25rem;  /* Heading font size */
      font-weight: bold;   /* Bold heading */
      color: #333;         /* Dark text color */
    }

    /* Image styling */
    .stateofart .icon-image {
      width: 20rem;  /* Image width */
      height: 20rem; /* Image height */
      object-fit: contain; /* Ensure the image maintains its aspect ratio */
    }

    /* Styling for the description text */
    .stateofart .text-sm {
      font-size: 1.5rem;   /* Text font size */
      color: #666;       /* Lighter color for the text */
      margin-top: 16px;  /* Adds space above the text to separate it from the heading/image */
    }

    @media (max-width: 768px) {
    .items-container {
      grid-template-columns: 1fr;  /* 1 item per row */
    }
  .strength-section .flex{
    display: flow;
  }
    /* Stack the image below the text content */
    .item, .stateofart {
      display: flex;
      flex-direction: column; /* Stack items vertically */
      align-items: center;    /* Center-align content */
      text-align: center;     /* Center text */
    }

    /* Style the image */
    .item img, .stateofart img {
          margin-top: 10px;
          width: 20rem;
          height: 20rem;
    }
      .stateofart .flex {
      display: flow;
      align-items: end;
      gap: 16px;
  }
  }
</style>

{% schema %}
{
  "name": "Our Strength Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Strengths"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Showcasing the core values and quality behind our products."
    }
  ],

}
{% endschema %}

<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<script>
  AOS.init();
</script>
