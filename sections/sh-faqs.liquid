    },
    {
      "type": "color",
      "id": "content_color",
      "label": "Content color",
      "default": "#121212"
    },
    {
      "type": "paragraph",
      "content": "FAQ's"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#d9d9d9"
    },
    {
      "type": "color",
