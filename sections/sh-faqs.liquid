      "default": "#111"
    },
    {
      "type": "color",
      "id": "answer_color",
      "label": "Content color",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "paragraph",
      "content": "Desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
