{%- capture sh_timeline_css -%}
  <style>
    #sh-{{ section.id }}.sh-timeline{padding:{{section.settings.padding_top}}px 0 {{section.settings.padding_bottom}}px 0;background: {{ section.settings.bg_color }};} 
    #sh-{{ section.id }} .sh-page-with {max-width: {{ section.settings.section_max_width }}px; width: 100%; padding: 0 20px; margin: 0 auto; }
    #sh-{{ section.id }} .sh-timeline-title h2 {font-size: {{section.settings.title_font_size}}px;font-weight: 500;margin:0 0 20px;color: {{section.settings.title_color}};} 
    #sh-{{ section.id }} .sh-timeline-title{margin: 0 auto 30px;}  
    #sh-{{ section.id }} .sh-timeline-desc p {margin: 0;font-size: {{ section.settings.content_font_size }}px;line-height: 1.4;color: {{section.settings.content_color}};}    
    #sh-{{ section.id }} .sh-button {font-size: 16px; line-height: 1.65;background: {{section.settings.btn_bg_color}}; color: {{section.settings.btn_text_color}}; padding: 6px 20px; min-width: 140px; display: inline-block; border:1px solid {{section.settings.btn_border_color}};border-radius: {{section.settings.border_radius}}px;text-align: center; cursor:pointer;}
    #sh-{{ section.id }} .sh-button:hover{background: {{section.settings.btn_hover_bg_color}};color: {{section.settings.btn_hover_text_color}};border:1px solid {{section.settings.btn_hover_border_color}};box-shadow: 0 0 5px 0px {{section.settings.outline_btn_shadow_color}};} 
    #sh-{{ section.id }} .sh-button.sh-button-outline {color: {{section.settings.outline_btn_text_color}};border-color: {{section.settings.outline_btn_text_color}};background: transparent;}
    #sh-{{ section.id }} .sh-timeline-heading {font-weight: 500;margin: 0 0 20px;font-size: {{ section.settings.timeline_title_font_size }}px; line-height: 1.3;color: {{ section.settings.sec_title_color }};}
    #sh-{{ section.id }} .sh-timeline-description p {margin: 0 0 15px; font-size:16px; line-height: 1.4;} 
    #sh-{{ section.id }} .sh-timeline-img-with-txt {display: flex; flex-wrap:wrap;background: transparent;gap:100px; position: relative;}
    #sh-{{ section.id }} .sh-timeline-img-with-txt.sh-timeline-left-media{flex-direction: row;}
    #sh-{{ section.id }} .sh-timeline-img-with-txt.sh-timeline-right-media{flex-direction: row-reverse;}     
    #sh-{{ section.id }} .sh-timeline-text-content {flex-basis: calc(50% - 50px);;display: flex;line-height: 1.5;margin-bottom: 25px;font-size: {{ section.settings.timeline_content_font_size }}px;color: {{ section.settings.sec_content_color }};}
    #sh-{{ section.id }} .sh-timeline-text-content span {font-size: {{section.settings.timeline_subheading_font_size}}px;}
    #sh-{{ section.id }} .sh-timeline-image-box {flex-basis: calc(50% - 50px);position: relative;aspect-ratio: {{section.settings.image_aspect_ratio}};} 
    #sh-{{ section.id }} .sh-timeline-image-box img{position: absolute;top: 0;left: 0;right: 0;bottom: 0;width: 100%;height: 100%;object-fit: cover;object-position: center;}
    #sh-{{ section.id }} .sh-timeline-image-box.sh-empty-img {background: grey;}    
    #sh-{{ section.id }} .sh-timeline-text-content.sh-timeline-text-content-middle{align-items: center;}
    #sh-{{ section.id }} .sh-timeline-text-content.sh-timeline-text-content-top{align-items: flex-start;}
    #sh-{{ section.id }} .sh-timeline-text-content.sh-timeline-text-content-bottom{align-items: flex-end;}
    #sh-{{ section.id }} .sh-timeline-text-content-in.sh-timeline-align-center {text-align: center;}
    #sh-{{ section.id }} .sh-timeline-text-content-in.sh-timeline-align-left {text-align: left;} 
    #sh-{{ section.id }} .sh-timeline-text-content-in.sh-timeline-align-right {text-align: right;}
    #sh-{{ section.id }} .sh-timeline-wrapper .sh-timeline-img-with-txt svg.dot-milestone {content: "";display: block;position: absolute;top: 0px;left: 50%;width: 17px;height: 17px;border-radius: 13px;z-index: 4;fill: #fff;stroke: #000;transform: translateX(-50%);}
    #sh-{{ section.id }} .sh-timeline-wrapper.sh-timeline-wrapper-1 .sh-timeline-img-with-txt svg.dot-milestone {top: 20px;}
    #sh-{{ section.id }} .sh-timeline-wrapper {position: relative; padding-bottom: 50px;}
     #sh-{{ section.id }} .sh-timeline-wrapper:last-child {padding-bottom: 0;}
    #sh-{{ section.id }} .sh-timeline-wrapper:before {content: "";display: block;position: absolute;left: 50%;top: 0;width: 0;height: 100%;border-left: 1px solid #e5e5e5;transform: translateX(-50%);z-index: 1;}
    #sh-{{ section.id }} .sh-timeline-wrapper:after {content: "";display: block;position: absolute;left: 50%;top: 0;transform: translateX(-50%);width: 0;height: var(--after-height, 0%);border-left: 1px solid #000; z-index: 1;}
    #sh-{{ section.id }} video.sp-media-scroll-video {position: absolute;top: 0;left: 0;right: 0;bottom: 0;width: 100%;height: 100%;object-fit: cover;object-position: center;} 
    #sh-{{ section.id }} .sh-timeline-wrapper.sh-timeline-wrapper-1 { padding-top: 50px;}
   
    @media only screen and (max-width: 767px){
      #sh-{{ section.id }}.sh-timeline{padding:{{section.settings.mob_padding_top}}px 0 {{section.settings.mob_padding_bottom}}px 0;} 
      #sh-{{ section.id }} .sh-timeline-title h2 {margin: 0 0 10px;font-size: 26px;} 
      #sh-{{ section.id }} .sh-timeline-desc p {font-size: 14px;} 
      #sh-{{ section.id }} .sh-timeline-image-box {flex: 0 0 100%;}
      #sh-{{ section.id }} .sh-timeline-text-content {flex: 0 0 100%;padding:15px 0;}     
      #sh-{{ section.id }} .sh-timeline-heading {margin: 0 0 10px;font-size: 24px;}  
      #sh-{{ section.id }} .sh-timeline-description p {font-size:15px;}  
      #sh-{{ section.id }} .sh-timeline-img-with-txt{gap:0;}  
      #sh-{{ section.id }} .sh-timeline-wrapper {padding-left: 25px;} 
      #sh-{{ section.id }} .sh-timeline-wrapper:before , #sh-{{ section.id }} .sh-timeline-wrapper:after{ left:0;}
      #sh-{{ section.id }} .sh-timeline-wrapper .sh-timeline-img-with-txt svg.dot-milestone{left: -25px;}
      #sh-{{ section.id }} .sh-button {font-size: 15px;} 
    }
  </style>
{%- endcapture -%}
{{- sh_timeline_css | strip_newlines -}}
  
<div id="sh-{{ section.id }}" class="sh-timeline" data-id="{{ section.id }}">
  <div class="sh-page-with">
    {% if section.settings.title != blank or section.settings.content != blank %}
      <div class="sh-timeline-title sh-title-align-{{ section.settings.text_align }}">
        {% if section.settings.title != blank %}
          <h2>{{ section.settings.title }}</h2>
        {% endif %}
        {% if section.settings.content != blank %}
          <div class="sh-timeline-desc sh-section-desc">
            {{ section.settings.content }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        <div class="sh-timeline-wrapper {% if forloop.first %}sh-timeline-wrapper-{{ forloop.index }}{% endif %}">
          <div class="sh-timeline-img-with-txt sh-timeline-{{ block.settings.image_align }}-media">
            <div class="sh-timeline-image-box{% unless block.settings.image != blank %} sh-empty-img{% endunless %}">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 660 }}" height="" width="" loading="lazy" alt="{{ block.settings.image.alt }}" style="aspect-ratio: {{ block.settings.image.aspect_ratio }}">
              {% else %}  
                {% if block.settings.video != blank %}
                  {% assign poster = "" %}
                  {% if block.settings.poster != blank %}  
                    {% assign poster =  block.settings.poster | image_url: width: block.settings.poster.width %}
                  {% endif %}
  
                  {% assign control = true %}
                  {% if block.settings.autoplay_video == true and block.settings.loop_video == true %}  
                    {% assign control = false %}
                  {% endif %}  
                  {{ block.settings.video | video_tag: image_size: '1100x', class: 'sp-media-scroll-video', playsinline: true, autoplay: block.settings.autoplay_video, loop: block.settings.loop_video, controls: control, muted: block.settings.mute_video, preload: 'metadata', poster: poster }}
                {% endif %}
              {% else %}
                <img src="data:image/svg+xml,%3C%3Fxml version='1.0' encoding='UTF-8'%3F%3E%3Csvg version='1.1' viewBox='0 0 500 500' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Crect x='2' y='2' width='496' height='496' fill='%23D8D8D8' stroke='%23D8D8D8' stroke-width='4'/%3E%3C/g%3E%3C/svg%3E" width="" height="" loading="lazy" alt="Timeline">
              {% endif %}
            </div>
            
            {% if block.settings.content_title != blank or block.settings.description != blank %}
              <div class="sh-timeline-text-content sh-timeline-text-content-{{ block.settings.content_alignment }}">
                <div class="sh-timeline-text-content-in sh-timeline-align-{{ block.settings.box_text_align }}">
                  {% if block.settings.sub_title != blank %}
                    <span>{{ block.settings.sub_title }}</span>
                  {% endif %}
                  {% if block.settings.content_title != blank %}
                    <h2 class="sh-timeline-heading">{{ block.settings.content_title }}</h2>
                  {% endif %}
                  {% if block.settings.description != blank %}
                    <div class="sh-timeline-description">
                      {{ block.settings.description }}
                    </div>
                  {% endif %}
                  
                  {% if block.settings.btn_txt != blank and block.settings.btn_link != blank %}
                    <a href="{{ block.settings.btn_link }}" class="sh-button{% if section.settings.btn_outline %} sh-button-outline{% endif %}">
                      {{ block.settings.btn_txt }}
                    </a>
                  {% endif %}
                </div>
              </div>
            {% endif %}
            <svg class="dot-milestone" xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 17 17" fill="none">
              <circle cx="8.5" cy="8.5" r="8" fill="#fff"></circle>
            </svg>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% if section.blocks.size > 0 %}
<script>
  document.addEventListener('DOMContentLoaded', function() {
    var lastScrollY = window.scrollY;
    var scrollDirection = 'down';
    
    window.addEventListener('scroll', function() {
      if (window.scrollY > lastScrollY) {
        scrollDirection = 'down'; 
      } else {
        scrollDirection = 'up'; 
      }
      lastScrollY = window.scrollY; 
    });

    var observer = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
      var dot = entry.target.querySelector('.dot-milestone circle');
      
      var timelineItem = entry.target;
      if (scrollDirection === 'down') {
        if (entry.isIntersecting) {
          timelineItem.style.setProperty('--after-height', '100%');
          dot.style.fill = "#000"; 
        }
      }
      else if (scrollDirection === 'up') {
        if (entry.isIntersecting) {
          timelineItem.style.setProperty('--after-height', '100%');
          dot.style.fill = "#000"; 
        } else {
          timelineItem.style.setProperty('--after-height', '0%');
          dot.style.fill = "#fff"; 
        }
      }
    });
    }, {
      threshold: 0.5 
    });

    var timelineItems = document.querySelector("#sh-{{ section.id }}").querySelectorAll('.sh-timeline-wrapper');
    timelineItems.forEach(item => {
      observer.observe(item); 
    });

    if (Shopify.designMode) {
      document.addEventListener('shopify:section:load', function(event) {
        var timelineItems1 = document.querySelector("#sh-"+event.target.querySelector(".sh-timeline").dataset.id).querySelectorAll('.sh-timeline-wrapper');
        timelineItems1.forEach(item => {
          observer.observe(item); 
        });
      });
    }
  });
</script>
{% endif %}
  
