{% schema %}
{
  "name": "Product Certificate",
  "settings": [
    {
      "type": "text",
      "label": "Section Title",
      "id": "section_title",
      "default": "Our Certifications"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "label": "Slide Icon",
          "id": "slide_icon",
          "info": "Upload an image for the slide."
        },
        {
          "type": "text",
          "label": "Slide Text",
          "id": "slide_text",
          "default": "Your slide text goes here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Certificate",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<div class="third-party-certifications">
  <div class="container">
    <div class="section-title">
      <h2>{{ section.settings.section_title }}</h2>
    </div>
    <div class="certifications-slider">
      {% for block in section.blocks %}
        <div class="certification-card">
          {% if block.settings.slide_icon %}
            <img src="{{ block.settings.slide_icon | img_url: 'medium' }}" alt="Slide Icon" class="slider-icon" />
          {% endif %}
          <p class="slider-text">{{ block.settings.slide_text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</div>


<style>
  .third-party-certifications {
    padding: 40px 0;
    background-color: #f5f5f5;
    text-align: center;
  }

  .third-party-certifications h2 {
    font-size: 24px;
    margin-bottom: 20px;
  }

  .certifications-slider {
    display: grid;
    grid-auto-flow: column;
    gap: 20px;
    
    align-items: center; /* Center items vertically */
    overflow-x: auto;
    padding: 10px;
  }

  .certifications-slider::-webkit-scrollbar {
    height: 8px;
  }

  .certifications-slider::-webkit-scrollbar-thumb {
    background: #ccc;
    border-radius: 4px;
  }

  .certification-card {
    background: #fff;
    border-radius: 8px;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    padding: 20px;
    text-align: center;
    min-width: 250px; /* Ensures consistent width for all cards */
  }

  .certification-card img {
    max-width: 100px;
  }

  .certification-card p {
    font-size: 14px;
    line-height: 1.6;
    color: #333;
  }

  /* Mobile-specific styles */
  @media (max-width: 768px) {
    .certifications-slider {
      gap: 10px;
    }

    .certification-card {
      min-width: 200px;
    }
  }
</style>