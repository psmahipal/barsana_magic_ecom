{%- capture sh_image_with_text_2 -%}
  <style>
    #sh-{{ section.id }}.sh-image-with-text-2-section {padding: {{section.settings.padding_top}}px 0 {{section.settings.padding_bottom}}px 0;background-color: {{section.settings.bg_color}};}
    #sh-{{ section.id }} .sh-page-with {max-width: {{section.settings.section_max_width}}px;width: 100%;padding: 0 20px;margin: 0 auto;}
    #sh-{{ section.id }} .sh-image-with-text-2-wrapper{display: flex;flex-wrap: wrap;align-items: center;background: {{section.settings.content_bg_color}};}
    #sh-{{ section.id }} .sh-image-with-text-2-wrapper.sh-img-media-left {flex-direction: row-reverse;}
    #sh-{{ section.id }} .sh-image-with-text-2-wrapper.sh-img-media-right {flex-direction: row;}
    #sh-{{ section.id }} .sh-image-with-text-2-text {flex: 0 0 45%;text-align: {{section.settings.text_align}};padding: 30px;}
    #sh-{{ section.id }} .sh-image-with-text-2-title {font-size: {{ section.settings.title_font_size }}px;line-height: 1.3;color: {{section.settings.title_color}};font-weight: 500;margin: 0 ;}
    #sh-{{ section.id }} .sh-image-with-text-2-description p {font-size: {{ section.settings.content_font_size }}px;line-height: 1.5;color: {{section.settings.content_color}};margin:20px 0 0 0;}
    #sh-{{ section.id }} .sh-image-with-text-2-icon-wrapper {display: flex;gap: 10px;margin: 20px 0 0 0;justify-content: {{section.settings.text_align}};}
    #sh-{{ section.id }} .sh-image-with-text-2-icon {width: 60px;height: 60px;object-fit: contain;}
    #sh-{{ section.id }} .sh-button {margin:25px 0 0 0;font-size: 16px;line-height: 1.65;background: {{section.settings.btn_bg_color}};color: {{section.settings.btn_text_color}};padding: 6px 20px;min-width: 140px;display: inline-block;border: 1px solid {{section.settings.btn_border_color}};border-radius: {{section.settings.border_radius}}px;text-align: center;cursor: pointer;}
    #sh-{{ section.id }} .sh-button:hover {background: {{section.settings.btn_hover_bg_color}};color: {{section.settings.btn_hover_text_color}};border: 1px solid {{section.settings.btn_hover_border_color}};box-shadow: 0 0 5px 0px {{section.settings.outline_btn_shadow_color}};}
    #sh-{{ section.id }} .sh-button.sh-button-outline {color: #000000;border-color: #000000;background: transparent;}
    #sh-{{ section.id }} .sh-image-with-text-2-image {flex: 0 0 55%;position: relative;}
    #sh-{{ section.id }} .sh-image-with-text-2-image img{position: absolute;top: 0;left: 0;right: 0;bottom: 0;width: 100%;height: 100%;object-fit: cover;object-position: center;}
    #sh-{{ section.id }} .sh-image-with-text-2-image.sh-empty-img {background: grey;opacity: 0.3;}
    #sh-{{ section.id }} .sh-image-with-text-2-image.sh-img-small {padding-bottom: 38%;}
    #sh-{{ section.id }} .sh-image-with-text-2-image.sh-img-medium {padding-bottom: 46%;}
    #sh-{{ section.id }} .sh-image-with-text-2-image.sh-img-large {padding-bottom: 55%;}
    #sh-{{ section.id }} .sh-image-with-text-2-image.sh-img-adapt {padding-bottom: unset;}
    #sh-{{ section.id }} .sh-image-with-text-2-image.sh-img-adapt img {position:relative;}
    #sh-{{ section.id }} .sh-button.sh-button-outline {color: {{section.settings.outline_btn_text_color}};border-color: {{section.settings.outline_btn_text_color}};background: transparent;}
    
    @media only screen and (max-width: 767px){
      #sh-{{ section.id }}.sh-image-with-text-2-section {padding: {{section.settings.mob_padding_top}}px 0 {{section.settings.mob_padding_bottom}}px 0;}
      #sh-{{ section.id }} .sh-image-with-text-2-text{flex: 0 0 100%;padding:20px;}
      #sh-{{ section.id }} .sh-image-with-text-2-image{flex: 0 0 100%;}
      #sh-{{ section.id }} .sh-image-with-text-2-image.sh-img-small {padding-bottom: 65%;}
      #sh-{{ section.id }} .sh-image-with-text-2-image.sh-img-medium {padding-bottom: 80%;}
      #sh-{{ section.id }} .sh-image-with-text-2-image.sh-img-large {padding-bottom: 100%;}
      #sh-{{ section.id }} .sh-image-with-text-2-title {font-size: 26px;}
      #sh-{{ section.id }} .sh-image-with-text-2-description p{font-size: 14px;margin: 10px 0 0 0;}
      #sh-{{ section.id }} .sh-image-with-text-2-icon {width: 45px;height: 45px;}
      #sh-{{ section.id }} .sh-button {font-size: 15px;margin: 15px 0 0 0;}
    }
  </style>
{%- endcapture -%}
{{- sh_image_with_text_2 | strip_newlines -}}

<div id="sh-{{ section.id }}" class="sh-image-with-text-2-section">
  <div class="sh-page-with">
    <div class="sh-image-with-text-2-wrapper sh-img-media-{{ section.settings.image_align }}">
      <div class="sh-image-with-text-2-text">
        {% if section.settings.title != blank %}
          <h2 class="sh-image-with-text-2-title">{{ section.settings.title }}</h2>
        {% endif %}
        {% if section.settings.content != blank %}
          <div class="sh-image-with-text-2-description">{{ section.settings.content}}</div>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <div class="sh-image-with-text-2-icon-wrapper">
            {% for block in section.blocks %}
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url }}" alt="{{block.settings.imagea.alt}}" class="sh-image-with-text-2-icon" height="" width="" loading="lazy">
              {% else %}
                <img src="data:image/svg+xml,%3C%3Fxml version='1.0' encoding='UTF-8'%3F%3E%3Csvg version='1.1' viewBox='0 0 500 500' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Crect x='2' y='2' width='496' height='496' fill='%23D8D8D8' stroke='%23D8D8D8' stroke-width='4'/%3E%3C/g%3E%3C/svg%3E" width="" height="" class="sh-image-with-text-2-icon" loading="lazy" alt="image" >
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
        
        {% if section.settings.link != blank and section.settings.btn_text != blank %}
          <a href="{{ section.settings.link }}" class="sh-button{% if section.settings.btn_outline %} sh-button-outline{% endif %}" >{{- section.settings.btn_text -}}</a>
        {% endif %}
      </div>
      
      <div class="sh-image-with-text-2-image sh-img-{{ section.settings.image_height }}">
        {% if section.settings.image != blank %}
          <img src="{{ section.settings.image | image_url }}" alt="{{section.settings.image.alt}}" class="sh-image-with-text-2-banner-image" height="" width="" loading="lazy" >
        {% else %}
          <img src="data:image/svg+xml,%3C%3Fxml version='1.0' encoding='UTF-8'%3F%3E%3Csvg version='1.1' viewBox='0 0 500 500' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Crect x='2' y='2' width='496' height='496' fill='%23D8D8D8' stroke='%23D8D8D8' stroke-width='4'/%3E%3C/g%3E%3C/svg%3E" width="" class="sh-image-with-text-2-banner-image" height="" loading="lazy" alt="image" >
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SH: Image with text 2",
  "tag": "section",
  "class": "sh-section-hub-main",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_height",
      "label": "Height",
      "options": [
        {"value": "small", "label": "Small"},
        {"value": "medium", "label": "Medium"},
        {"value": "large", "label": "Large"},
        {"value": "adapt", "label": "Auto"}
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "image_align",
      "label": "Position",
      "options": [
        { "label": "Left", "value": "left" },
        { "label": "Right", "value": "right" }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "Content part"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Awards & Accreditations"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Lorem Ipsum has been the industry's standard dummy text ever since the 1500s, when an unknown printer took a galley of type and scrambled it to make a type specimen book.</p>"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button label",
      "default": "Buy Now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link",
      "default": "/"
    },
    {
      "type": "checkbox",
      "id":"btn_outline",
      "label": "Use outline button",
      "default": false
    },
    {
      "type": "color",
      "id": "outline_btn_text_color",
      "label": "Outline color",
      "default": "#000000"
    },
    {
      "type":"range",
      "id":"border_radius",
      "label": "Button border radius",
      "min": 0,
      "max": 20,
      "default": 0,
      "step": 1,
      "unit": "px"
    },
    {
      "type":"text_alignment",
      "id":"text_align",
      "label": "Text alignment",
      "default": "center"
    },
    {
      "type": "header",
      "content": "Font size"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 5,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Heading",
      "default": 30
    },
    {
      "type": "range",
      "id": "content_font_size",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Content", 
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#f2f2f2"
    },
    {
      "type": "paragraph",
      "content": "Content part"
    },
    {
      "type": "color",
      "id": "content_bg_color",
      "label": "Background color",
      "default": "#f2f2f2"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Heading color",
      "default": "#000"
    },
    {
      "type": "color",
      "id": "content_color",
      "label": "Content color",
      "default": "#121212"
    },
    {
      "type": "paragraph",
      "content": "Button"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_border_color",
      "label": "Border color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "btn_hover_bg_color",
      "label": "Hover background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_hover_text_color",
      "label": "Hover text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "btn_hover_border_color",
      "label": "Hover border color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "outline_btn_shadow_color",
      "label": "Shadow color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "paragraph",
      "content": "Desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    },
    {
      "type": "paragraph",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "mob_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding top",
      "default": 30
    },
    {
      "type": "range",
      "id": "mob_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding bottom",
      "default": 30
    },
    {
      "type": "header",
      "content": "Section width"
    },
    {
      "type": "text",
      "id": "section_max_width",
      "label": "Width (in px)",
      "default": "1140"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SH: Image with text 2",
      "blocks": [
        {
          "type": "badge"
        },
        {
          "type": "badge"
        },
        {
          "type": "badge"
        },
        {
          "type": "badge"
        },
        {
          "type": "badge"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["footer","header"]
  }
}
{% endschema %}
