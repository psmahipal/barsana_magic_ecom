:0,"image_height":"adapt","desktop_content_position":"middle-center","show_text_box":false,"desktop_content_alignment":"center","color_scheme":"","image_behavior":"none","mobile_content_alignment":"center","stack_images_on_mobile":false,"show_text_below":false}},"collapsible_content_refUmw":{"type":"collapsible-content","blocks":{"collapsible_row_KBwYVk":{"type":"collapsible_row","settings":{"heading":"What is Sanjeevani Organics Natural Acacia Honey?","icon":"bottle","row_content":"<p>Sanjeevani Organics Natural Acacia Honey is a premium-quality honey sourced from the nectar of Acacia tree blossoms in the Himalayan foothills. It is 100% natural, unpasteurized, and free from any additives, offering a mild, light flavor and liquid consistency.<\/p>","page":""}},"collapsible_row_GJNCBB":{"type":"collapsible_row","settings":{"heading":" What are the benefits of Sanjeevani Organics Natural Acacia Honey?","icon":"bottle","row_content":"<p>Sanjeevani Organics Natural Acacia Honey is pure and natural, retaining essential enzymes and nutrients due to its unpasteurized state. It adds a mild sweetness, making it ideal for use in drinks, desserts, and recipes<\/p>","page":""}},"collapsible_row_GmU3iF":{"type":"collapsible_row","settings":{"heading":"Why choose Sanjeevani Organics Natural Acacia Honey?","icon":"bottle","row_content":"<p>Sanjeevani Organics Natural Acacia Honey stands out because it is ethically sourced from untouched forest regions, 100% natural, and unpasteurized. It contains no additives or preservatives, ensuring authenticity and high quality.<\/p>","page":""}},"collapsible_row_C3NXWN":{"type":"collapsible_row","settings":{"heading":"How is Sanjeevani Organics Natural Acacia Honey different from regular honey?","icon":"bottle","row_content":"<p>Sanjeevani Organics Natural Acacia Honey is distinct because it is collected from natural mono flora in pristine regions, ensuring a rich taste and nutrient retention, unlike processed honey, which may contain additives or undergo pasteurization.<\/p>","page":""}},"collapsible_row_9eQ6hg":{"type":"collapsible_row","settings":{"heading":"What is the shelf life of Sanjeevani Organics Natural Acacia Honey?","icon":"bottle","row_content":"<p>Sanjeevani Organics Natural Acacia Honey has a shelf life of 12 months. Store it in a cool, dry place to maintain its quality and texture.<\/p>","page":""}},"collapsible_row_nFptDg":{"type":"collapsible_row","settings":{"heading":"How should Sanjeevani Organics Natural Acacia Honey be stored?","icon":"bottle","row_content":"<p>Store it in a cool, dry place away from direct sunlight. It does not require refrigeration. If crystallization occurs, gently warm the jar in water to return it to a liquid state. Natural honey crystallises under normal conditions.<\/p>","page":""}},"collapsible_row_cNCYkp":{"type":"collapsible_row","settings":{"heading":" Where can I use Sanjeevani Organics Natural Acacia Honey?","icon":"bottle","row_content":"<p>You can use it in beverages like tea and coffee, as a topping for toast or pancakes, and in cooking or baking for natural sweetness.<\/p>","page":""}},"collapsible_row_UPqk4C":{"type":"collapsible_row","settings":{"heading":"Can Sanjeevani Organics Natural Acacia Honey crystallize?","icon":"bottle","row_content":"<p>Yes, it can crystallize over time, especially in cooler temperatures. Crystallization is a natural process for unpasteurized honey and does not affect its quality. Warm it gently to liquefy.<\/p>","page":""}},"collapsible_row_ChzPiF":{"type":"collapsible_row","settings":{"heading":"Is Sanjeevani Organics Natural Acacia Honey raw or processed?","icon":"dairy","row_content":"<p>Sanjeevani Organics Natural Acacia Honey is 100% natural and unprocessed ensuring it retains its natural enzymes and nutrients. It is free from additives and preservatives.<\/p>","page":""}}},"block_order":["collapsible_row_KBwYVk","collapsible_row_GJNCBB","collapsible_row_GmU3iF","collapsible_row_C3NXWN","collapsible_row_9eQ6hg"